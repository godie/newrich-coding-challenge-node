{
  "name": "api",
  "version": "1.0.0",
  "description": "Intentionally imperfect NestJS API baseline for coding challenge.",
  "main": "dist/main.js",
  "scripts": {
    "start": "ts-node src/main.ts",
    "start:dev": "ts-node src/main.ts",
    "build": "tsc -p tsconfig.json",
    "test": "node ./node_modules/jest/bin/jest.js --config ./jest.config.ts --runInBand",
    "test:watch": "node ./node_modules/jest/bin/jest.js --config ./jest.config.ts --watch",
    "test:cov": "node ./node_modules/jest/bin/jest.js --config ./jest.config.ts --coverage"
  },
  "keywords": [
    "nestjs",
    "coding-challenge"
  ],
  "author": "",
  "license": "UNLICENSED",
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^25.6.0",
    "@types/supertest": "^7.2.0",
    "jest": "^30.3.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.9",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.19",
    "@nestjs/core": "^11.1.19",
    "@nestjs/platform-express": "^11.1.19",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  }
}
